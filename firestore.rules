rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with ADMIN_EMAILS in src/admins.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'medinaacademylearning@gmail.com'
      ];
    }

    match /users/{userId}/data/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /events/{eventId} {
      // Anyone can view events; only an admin can post or remove them
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subscribers/{email} {
      // Anyone may subscribe, but only an admin may read the list — a mailing
      // list readable by the public is a leak. Shape and size are constrained
      // so an open create cannot be used to store arbitrary data.
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 200;
      allow read, delete: if isAdmin();
    }

    match /students/{studentId} {
      // Parents may read only records linked to their own email; admins read all
      allow read: if request.auth != null &&
        (resource.data.parentEmail == request.auth.token.email || isAdmin());
      // Only an admin can add or remove students
      allow create, update, delete: if isAdmin();
    }
  }
}

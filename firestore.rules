rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with ADMIN_EMAILS in src/components/CommunityEvents.jsx
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'fathiyayoosef@gmail.com'
      ];
    }

    match /users/{userId}/data/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /events/{eventId} {
      // Anyone can view events; only an admin can post or remove them
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      // Parents may read only records linked to their own email; admins read all
      allow read: if request.auth != null &&
        (resource.data.parentEmail == request.auth.token.email || isAdmin());
      // Only an admin can add or remove students
      allow create, update, delete: if isAdmin();
    }
  }
}
